# Copy to /etc/streampdf/streampdf.env, chmod 0640, owned by root:streampdf.
# Never commit the real file.

# Required for a public domain. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN=replace-with-at-least-16-random-characters

# Comma-separated hostnames (optionally with port). Non-loopback binds refuse
# to start without this.
ALLOWED_HOSTS=pdf.example.com

# Only needed when a separate frontend origin calls the API.
# ALLOWED_ORIGINS=https://app.example.com

# Behind a TLS-terminating reverse proxy.
TRUST_PROXY=1
ENABLE_HSTS=1

# Optional observability.
LOG_LEVEL=info
METRICS_LOG_INTERVAL_MINUTES=15
# ENABLE_METRICS=1

# Optional limits (defaults shown).
# MAX_DOCUMENTS=100
# MAX_DOCUMENTS_PER_IP=5
# MAX_REMOTE_BYTES=2147483648
# DOCUMENT_TTL_MINUTES=30
# MAX_CONCURRENT_STREAMS=100
# ALLOWED_REMOTE_PORTS=80,443
# REMOTE_HEADERS_TIMEOUT_MS=20000
# REMOTE_BODY_IDLE_TIMEOUT_MS=30000
