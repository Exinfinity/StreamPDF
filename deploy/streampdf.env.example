# Copy to /etc/streampdf/streampdf.env, chmod 0640, owned by root:streampdf.
# Never commit the real file.
#
# Values shown are the application defaults. Keep the bind on
# loopback and terminate TLS in nginx/Caddy in front of the app.
# systemd EnvironmentFile syntax: KEY=VALUE, one per line, no shell expansion.

# Required for a public/intranet hostname/IP (non-loopback bind). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN=replace-with-at-least-16-random-characters

# Comma-separated hostnames/IPs (optionally with port). Non-loopback binds
# refuse to start without this.
ALLOWED_HOSTS=pdf.intra.example.com,192.168.1.10

# Only needed when a separate frontend origin calls the API.
# ALLOWED_ORIGINS=https://app.example.com

# Behind a TLS-terminating reverse proxy.
TRUST_PROXY=1
ENABLE_HSTS=1

# Optional observability.
LOG_LEVEL=info
METRICS_LOG_INTERVAL_MINUTES=15
# ENABLE_METRICS=1

# Optional limits (defaults shown).
# MAX_DOCUMENTS=100
# MAX_DOCUMENTS_PER_IP=5
# MAX_REMOTE_BYTES=2147483648
# DOCUMENT_TTL_MINUTES=30
# MAX_CONCURRENT_STREAMS=100

# Remote address policy. Default (0) is the public-only strict mode: public
# addresses and the ALLOWED_REMOTE_PORTS allowlist only. Set
# ALLOW_PRIVATE_ADDRESSES=1 only on a trusted intranet that must read
# private/loopback/host PDFs at any port; link-local/cloud-metadata, multicast
# and reserved ranges stay blocked either way.
# ALLOW_PRIVATE_ADDRESSES=0
# ALLOWED_REMOTE_PORTS=80,443

# Optional upstream timeouts (defaults shown).
# REMOTE_HEADERS_TIMEOUT_MS=20000
# REMOTE_BODY_IDLE_TIMEOUT_MS=30000
