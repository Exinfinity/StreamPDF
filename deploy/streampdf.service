# StreamPDF hardened systemd unit (P3).
#
# Install:
#   sudo install -d -o streampdf -g streampdf /opt/streampdf /etc/streampdf
#   sudo cp -r server public package.json package-lock.json node_modules /opt/streampdf/
#   sudo install -m 0640 -o root -g streampdf deploy/streampdf.service /etc/systemd/system/
#   sudo install -m 0640 -o root -g streampdf deploy/streampdf.env.example /etc/streampdf/streampdf.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now streampdf
#
# The EnvironmentFile must contain at least:
#   AUTH_TOKEN=<long random token>
#   ALLOWED_HOSTS=pdf.example.com
# Keep the Node process on loopback and terminate TLS in nginx/Caddy.

[Unit]
Description=StreamPDF streaming PDF viewer
Documentation=https://github.com/example/StreamPDFPreviewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streampdf
Group=streampdf
WorkingDirectory=/opt/streampdf
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=LOG_LEVEL=info
EnvironmentFile=/etc/streampdf/streampdf.env
ExecStart=/usr/bin/node /opt/streampdf/server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077

# Privilege and filesystem hardening
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Node/V8 needs writable+executable memory for JIT. Do not set
# MemoryDenyWriteExecute=true unless you also disable the JIT (--jitless),
# which is not supported by current PDF.js workloads.
MemoryDenyWriteExecute=false

# Resource limits (adjust to host capacity)
LimitNOFILE=4096
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
